[Unit]
Description=SYSC session lock owner
BindsTo=niri.service graphical-session.target
After=niri.service
StartLimitIntervalSec=60
StartLimitBurst=3

[Service]
Type=notify
ExecStart=%h/.local/bin/sysc-lock --session
Restart=on-failure
RestartSec=1
TimeoutStartSec=10
TimeoutStopSec=3
LimitCORE=0
UMask=0077
RuntimeDirectory=sysc-lock
RuntimeDirectoryMode=0700
RuntimeDirectoryPreserve=restart

[Install]
WantedBy=graphical-session.target
