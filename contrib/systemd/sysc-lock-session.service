[Unit]
Description=SYSC session lock owner
# The compositor owns graphical-session.target, whether it is Niri or
# sysc-compositor. Binding the target covers both and stops the lock with the
# session, instead of requiring a unit named after one compositor.
BindsTo=graphical-session.target
After=graphical-session.target
StartLimitIntervalSec=60
StartLimitBurst=3

[Service]
Type=notify
ExecStart=%h/.local/bin/sysc-lock --session
Restart=on-failure
RestartSec=1
TimeoutStartSec=10
TimeoutStopSec=3
LimitCORE=0
UMask=0077
RuntimeDirectory=sysc-lock
RuntimeDirectoryMode=0700
RuntimeDirectoryPreserve=restart

[Install]
WantedBy=graphical-session.target
