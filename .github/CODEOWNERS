# The review path per area.
#
# There is one owner, so every path below names the same reviewer. The value of this file is the map:
# which paths belong to which repository, and which of them are cross-repository contracts. A change to
# a contract needs the repositories that consume it, not only the one that holds it.

# The default owner for everything in this repository.
/* @Nomadcxx

# The locker daemon and the authentication. The contract tests in the shell build this
# binary and run it, so a change here is a change to that contract.
/internal/lockd/ @Nomadcxx
/internal/auth/ @Nomadcxx

# The protocol bindings the locker draws through. The repository that owns the
# Wayland surface is sysc-wayland.
/protocols/ @Nomadcxx

# The daemon, the installer and the scripts.
/cmd/ @Nomadcxx
/scripts/ @Nomadcxx
/install.sh @Nomadcxx
